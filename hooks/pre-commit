#!/bin/bash

# Both steps below rewrite files in the working tree. If one of them changed something, the commit
# is aborted so the result can be staged.

snapshot() {
    find locale/ classes/guis/ -type f \( -name "*.cfg" -o -name "*.lua" \) | sort | xargs md5sum
}

BEFORE=$(snapshot)

# wiki pages: regenerate locale and GUI code for staged markdown files
STAGED_MD=$(git diff --cached --name-only --diff-filter=ACM | grep '^human-readable-wiki-pages/.*\.md$')
if [ -n "$STAGED_MD" ]; then
    echo "Regenerating locale and GUI code for staged markdown files..."
    FILENAMES=$(echo "$STAGED_MD" | xargs -I{} basename {})
    python3 human-readable-wiki-pages/convert.py $FILENAMES
fi

# locale: sort the blocks tagged with [sorted] in staged locale files
STAGED_CFG=$(git diff --cached --name-only --diff-filter=ACM | grep '^locale/.*\.cfg$')
if [ -n "$STAGED_CFG" ]; then
    python3 hooks/sort_locale.py $STAGED_CFG
fi

AFTER=$(snapshot)

if [ "$BEFORE" != "$AFTER" ]; then
    echo ""
    echo "Generated or sorted files were updated - stage the changes and commit again."
    exit 1
fi

exit 0
